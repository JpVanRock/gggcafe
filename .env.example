# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Site (safe for the browser; Row Level Security decides what it can see) ---
# Supabase Dashboard → Connect → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Database (server-side only: used by npm run db:check / db:push) ---
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
# Session pooler host: Dashboard → Connect → Connection String → Session pooler
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
# The database password you set when creating the project
# (Project Settings → Database → Reset database password if forgotten).
# Type it exactly as is: no quotes, no URL-encoding needed.
SUPABASE_DB_PASSWORD=
